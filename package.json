{
  "name": "dsh-capability-panel",
  "version": "0.1.0",
  "description": "Inspect and manage the skills, tools, and MCP capabilities available to a DeepSeek Harness agent session.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint --type-aware --tsconfig tsconfig.test.json src tests",
    "lint:fix": "oxlint --type-aware --tsconfig tsconfig.test.json src tests --fix",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "clean": "rm -rf lib",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pure-craft/dsh-capability-panel.git"
  },
  "homepage": "https://github.com/pure-craft/dsh-capability-panel",
  "bugs": {
    "url": "https://github.com/pure-craft/dsh-capability-panel/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "skills",
    "mcp",
    "tools",
    "context"
  ],
  "author": "PureCraft",
  "engines": {
    "node": ">=20"
  }
}
