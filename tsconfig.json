{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "outDir": "lib",
    "types": ["react", "node"]
  },
  // `tests` is included so type-aware lint resolves test files too: oxlint
  // reads the nearest tsconfig, and a file outside every `include` gets no
  // types at all — every node: import silently degrades to `error`, which
  // then shows up as a wall of no-unsafe-* violations. The build itself is
  // driven by tsdown, so this wider include costs nothing there.
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
